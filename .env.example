# Copy to .env and fill in. See docs/DATA_SOURCES.md for how to obtain
# EVDS_API_KEY and OPENAI_API_KEY. Everything else works with defaults.

APP_ENV=development
LOG_LEVEL=INFO

# --- Database (docker-compose maps these; override for local-without-docker dev) ---
DATABASE_URL=postgresql+asyncpg://investify:investify@localhost:55433/investify
DATABASE_URL_SYNC=postgresql+psycopg2://investify:investify@localhost:55433/investify

# --- Redis ---
REDIS_URL=redis://localhost:63790/0

# --- Auth (single user; see docs/SECURITY.md) ---
AUTH_DEV_BYPASS=true
JWT_SECRET=change-me-in-production
APP_USER_EMAIL=ozanozen4@gmail.com
APP_USER_PASSWORD=changeme

# --- TCMB EVDS (free registration required: https://evds2.tcmb.gov.tr) ---
# Without this, policy_rate/cpi_yoy fall back to a labeled mock seed.
EVDS_API_KEY=

# --- LLM interpretation: OpenAI (paid) takes priority if set, otherwise
# Gemini (free tier — good for local development) is used if set,
# otherwise a clearly-labeled deterministic mock. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gemini (free; https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
